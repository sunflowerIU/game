# Browser-visible API origin used by the Next.js app in local development.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_PLAYER_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Fastify runtime configuration.
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://127.0.0.1:3001
LOG_LEVEL=info

# Local PostgreSQL configuration. Production uses .env.production.
POSTGRES_DB=game_platform
POSTGRES_USER=game_platform
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://game_platform:change-me-for-local-development@127.0.0.1:5433/game_platform

# Omit both values to seed permissions without creating an administrator.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
